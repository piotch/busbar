@prefix pub: <https://busbar.example/publishing#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://busbar.example/id/grid/uk/dno/nged/catalogue>
    a dcat:Catalog, pub:TrackedCatalog ;
    dct:title "National Grid Electricity Distribution Open Data Catalogue"@en ;
    dct:publisher <https://busbar.example/id/grid/uk/dno/nged> ;
    foaf:homepage <https://connecteddata.nationalgrid.co.uk/dataset/> .

<https://busbar.example/id/grid/uk/dno/nged/catalogue/captures/dcat>
    a pub:CaptureSpecification ;
    pub:catalog <https://busbar.example/id/grid/uk/dno/nged/catalogue> ;
    pub:endpoint <https://connecteddata.nationalgrid.co.uk/catalog.rdf> ;
    pub:mediaType "application/rdf+xml" .
