@prefix pub: <https://busbar.example/publishing#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://busbar.example/id/grid/uk/dno/enwl/catalogue>
    a dcat:Catalog, pub:TrackedCatalog ;
    dct:title "Electricity North West Open Data Catalogue"@en ;
    dct:publisher <https://busbar.example/id/grid/uk/dno/enwl> ;
    foaf:homepage <https://electricitynorthwest.opendatasoft.com/explore/> .

<https://busbar.example/id/grid/uk/dno/enwl/catalogue/captures/dcat>
    a pub:CaptureSpecification ;
    pub:catalog <https://busbar.example/id/grid/uk/dno/enwl/catalogue> ;
    pub:endpoint <https://electricitynorthwest.opendatasoft.com/api/explore/v2.1/catalog/exports/dcat> ;
    pub:mediaType "application/rdf+xml" .
