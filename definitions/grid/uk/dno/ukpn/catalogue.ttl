@prefix pub: <https://busbar.example/publishing#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# This is UKPN's source catalogue, NOT Busbar's curated dcat:Catalog.
<https://busbar.example/id/grid/uk/dno/ukpn/catalogue>
    a dcat:Catalog, pub:TrackedCatalog ;
    dct:title "UKPN Open Data Catalogue"@en ;
    dct:publisher <https://busbar.example/id/grid/uk/dno/ukpn> ;
    foaf:homepage <https://ukpowernetworks.opendatasoft.com/explore/> .

<https://busbar.example/id/grid/uk/dno/ukpn/catalogue/captures/dcat>
    a pub:CaptureSpecification ;
    pub:catalog <https://busbar.example/id/grid/uk/dno/ukpn/catalogue> ;
    pub:endpoint <https://ukpowernetworks.opendatasoft.com/api/explore/v2.1/catalog/exports/dcat> ;
    pub:mediaType "application/rdf+xml" .
