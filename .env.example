# Local-only S3-compatible storage configuration. Never commit real credentials.
# In GitHub Actions, set BUCKET_ACCESS_KEY and BUCKET_SECRET_KEY as repository secrets.
BUCKET_URL=https://fsn1.your-objectstorage.com
BUCKET_NAME=busbar
BUCKET_PREFIX=catalogue-history
BUCKET_REGION=fsn1
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
