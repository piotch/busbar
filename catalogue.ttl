# Busbar catalogue
#
# Open datasets about the GB electricity grid, described with DCAT 3 and Dublin Core.
#   dcat:DatasetSeries  one dataset as a publisher releases it over time
#   dcat:Dataset        one edition of a series (dct:issued, dcat:prev to the previous edition)
#   dcat:Distribution   one file of an edition
# Terms prefixed busbar: and the resources prefixed id: (publishers, areas, dataset types, standards)
# are defined in busbar-ontology.ttl.

@prefix busbar: <https://busbar.example/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix filetype: <http://publications.europa.eu/resource/authority/file-type/> .
@prefix freq: <http://publications.europa.eu/resource/authority/frequency/> .
@prefix id: <https://busbar.example/id/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

id:busbar a dcat:Catalog ;
    dct:description "Open catalogue of open datasets about the GB electricity grid: where each dataset comes from, what it describes, its geographic and temporal coverage and its publication history. Terms are defined in busbar-ontology.json." ;
    dct:title "Busbar" ;
    dcat:dataset id:enwl.boundary-flow.enwl-boundary-flow-gsp-xy,
        id:enwl.boundary-flow.enwl-boundary-flow-merge,
        id:enwl.boundary-flow.gsp-boundary-flow,
